<Window x:Class="YukiCompanion.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        Topmost="True" Width="128" Height="128" WindowStartupLocation="Manual">
  <Grid Background="Transparent" MouseLeftButtonDown="DragOrOpen">
    <Image x:Name="Sprite" Stretch="Uniform" IsHitTestVisible="False"/>
  </Grid>
</Window>
