<Window x:Class="YukiCompanion.Windows.CompanionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Width="300" Height="300" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  </Window.Resources>
  <Border Background="#24131D" CornerRadius="18" Opacity="0.97" Padding="12" BorderBrush="#FF8FBE" BorderThickness="1.5">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" MouseLeftButtonDown="Drag" Margin="2,0,2,10"><StackPanel><TextBlock x:Name="CompanionName" FontSize="21" Foreground="#FF8FBE"/><TextBlock x:Name="Status" FontSize="11" Foreground="#DAB9C9"/></StackPanel><Button x:Name="MenuButton" DockPanel.Dock="Right" Content="☰" Width="32" Height="28" Click="OpenMenu" ToolTip="Yuki menu"><Button.ContextMenu><ContextMenu><Border Background="#24131D" BorderBrush="#FF8FBE" BorderThickness="1"><StackPanel Margin="8"><Button Content="Get started" Click="OpenSetup"/><Button Content="Settings…" Click="OpenSettings"/><Button Content="Check for updates" Click="CheckForUpdates"/></StackPanel></Border></ContextMenu></Button.ContextMenu></Button></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="2"><TextBlock x:Name="Transcript" TextWrapping="Wrap" Foreground="#FFF3F8"/></ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="LookButton" Content="◉" Width="32" Height="30" Click="Look" ToolTip="Attach selected app window"/><TextBox x:Name="Composer" MinWidth="105" Margin="7,0,0,0" Padding="8,5" Background="#38202E" Foreground="White" BorderBrush="#C95A8B" KeyDown="ComposerKeyDown"/><Button Content="Send" Margin="7,0,0,0" Click="Send" Background="#F25A9D" Foreground="White"/></DockPanel>
    </Grid>
  </Border>
</Window>
