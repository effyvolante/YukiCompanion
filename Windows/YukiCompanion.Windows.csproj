<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>YukiCompanion</AssemblyName>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <RootNamespace>YukiCompanion.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU</Platforms>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\PetAssets\Production\**\*.png" LinkBase="Assets\Yuki" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PetAssets\Production\animations.json" Link="Assets\Yuki\animations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
