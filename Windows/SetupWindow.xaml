<Window x:Class="YukiCompanion.Windows.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Get started with Yuki Companion" Width="590" Height="440" WindowStartupLocation="CenterScreen" Background="#24131D" Foreground="#FFF3F8">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#38202E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#C95A8B"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="#38202E"/><Setter Property="Foreground" Value="#20101A"/></Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Yuki Companion" FontSize="14" Foreground="#FF8FBE"/>
      <TextBlock x:Name="StepTitle" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,14"/>
      <TextBlock x:Name="StepBody" TextWrapping="Wrap" Foreground="#DAB9C9" Margin="0,0,0,18"/>
      <TextBox x:Name="NameBox" Visibility="Collapsed" FontSize="16"/>
      <ComboBox x:Name="WindowBox" Visibility="Collapsed" DisplayMemberPath="DisplayName" FontSize="16" Margin="0,10,0,0"/>
      <Button x:Name="RefreshWindowButton" Content="Refresh open windows" Visibility="Collapsed" HorizontalAlignment="Left" Click="RefreshWindows"/>
      <StackPanel x:Name="BrowserButtons" Orientation="Horizontal" Visibility="Collapsed">
        <Button x:Name="ChromeButton" Content="Open Chrome extensions" Click="OpenChromeExtensions"/>
        <Button x:Name="EdgeButton" Content="Open Edge extensions" Click="OpenEdgeExtensions"/>
      </StackPanel>
    </StackPanel>
    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,20,0,0">
      <Button x:Name="BackButton" Content="Back" Visibility="Collapsed" Click="Back"/>
      <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Continue" Background="#F25A9D" Foreground="White" Padding="24,9" Click="Next"/>
    </DockPanel>
  </Grid>
</Window>
