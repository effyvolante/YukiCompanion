<Window x:Class="YukiCompanion.Windows.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Set up Yuki Companion" Width="520" Height="330" WindowStartupLocation="CenterScreen">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="StepTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="StepBody" TextWrapping="Wrap" Margin="0,0,0,16"/><TextBox x:Name="NameBox" Visibility="Collapsed" FontSize="16"/><ComboBox x:Name="WindowBox" Visibility="Collapsed" DisplayMemberPath="Title" FontSize="16"/></StackPanel><Button Grid.Row="1" Content="Continue" HorizontalAlignment="Right" Padding="22,8" Click="Next"/></Grid>
</Window>
