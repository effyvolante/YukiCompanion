<Window x:Class="YukiCompanion.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yuki Companion Settings" Width="590" Height="650" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#24131D" Foreground="#FFF3F8">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Background" Value="#38202E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#C95A8B"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Background" Value="#38202E"/><Setter Property="Foreground" Value="#20101A"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Yuki Companion" FontSize="27" FontWeight="SemiBold" Foreground="#FF8FBE"/>
        <TextBlock Text="Personalize your app companion and choose the window she can see." Foreground="#DAB9C9" Margin="0,0,0,22"/>
        <GroupBox Header="Companion" Foreground="#FF9BC5" Padding="14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Name"/><TextBox x:Name="NameBox"/>
            <TextBlock Text="Theme"/><ComboBox x:Name="ThemeBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="More themes will appear here when available." Foreground="#B995A8" FontSize="12"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Visual context" Foreground="#FF9BC5" Padding="14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Open application to watch"/><DockPanel>
              <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshApplications"/>
              <ComboBox x:Name="ApplicationBox" DisplayMemberPath="DisplayName" SelectionChanged="ApplicationChanged"/>
            </DockPanel>
            <TextBlock Text="Window"/><ComboBox x:Name="WindowBox" DisplayMemberPath="Title" SelectionChanged="WindowChanged"/>
            <TextBlock Text="Yuki captures only the selected visible window. Keep it open and unminimized when using Look." Foreground="#DAB9C9" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
            <CheckBox x:Name="AutomaticLookBox" Content="Look automatically for visual questions" Margin="0,4,0,12"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Chrome connection" Foreground="#FF9BC5" Padding="14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Conversation name"/><TextBox x:Name="ConversationBox"/>
            <TextBlock Text="Yuki uses the shared Chrome extension and your normal logged-in ChatGPT tab; no API key is required." Foreground="#DAB9C9" TextWrapping="Wrap" FontSize="12"/>
            <Button Content="Open Chrome extensions" HorizontalAlignment="Left" Click="OpenChromeExtensions" Margin="0,12,0,0"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Startup" Foreground="#FF9BC5" Padding="14">
          <StackPanel>
            <CheckBox x:Name="LaunchAtLoginBox" Content="Launch Yuki when I sign in" Margin="0,4,0,12"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="AutomaticUpdatesBox" Content="Check for updates automatically" VerticalAlignment="Center"/>
              <Button Content="Check now" Click="CheckForUpdates" Margin="14,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Click="Cancel"/>
      <Button Content="Save" Background="#F25A9D" Foreground="White" Click="Save"/>
    </StackPanel>
  </Grid>
</Window>
